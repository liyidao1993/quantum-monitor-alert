{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quantum Monitor Binance Alert Daemon Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "enabled": { "type": "boolean" },
    "monitor": {
      "type": "object",
      "properties": {
        "top_volume": { "type": "number", "minimum": 0 },
        "price_seconds": { "type": "number", "minimum": 0 },
        "status_log_seconds": { "type": "number", "minimum": 10 }
      }
    },
    "instant_move": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "window_seconds": { "type": "number", "minimum": 0 },
        "threshold_percent": { "type": "number", "minimum": 0 },
        "watchlist_threshold_percent": { "type": "number", "minimum": 0 }
      }
    },
    "cooldown": {
      "type": "object",
      "properties": {
        "base_seconds": { "type": "number", "minimum": 0 },
        "same_direction_step_percent": { "type": "number", "minimum": 0 },
        "max_alerts_per_symbol_per_10min": { "type": "number", "minimum": 1 },
        "separate_up_down": { "type": "boolean" }
      }
    },
    "ma60_alerts": { "type": "object" },
    "ranking_broadcast": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "log_enabled": { "type": "boolean" },
        "broadcast_on_startup": { "type": "boolean" },
        "telegram_enabled": { "type": "boolean" },
        "weixin_enabled": { "type": "boolean" },
        "desktop_enabled": { "type": "boolean" },
        "interval_seconds": { "type": "number", "minimum": 30 },
        "top_n": { "type": "number", "minimum": 1, "maximum": 20 },
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["change_up", "change_down", "ma60_1m", "ma60_15m", "ma60_1d"]
          }
        }
      }
    },
    "watchlist": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "price_seconds": { "type": "number", "minimum": 5 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": { "type": "string" },
              "market": { "type": "string", "enum": ["Futures_Global", "Stocks_US", "Stocks_CN", "Futures_CN", "Crypto_Binance"] },
              "label": { "type": "string" },
              "group": { "type": "string", "enum": ["index_cn", "index_us"] },
              "alert_enabled": { "type": "boolean" },
              "enabled": { "type": "boolean" }
            },
            "required": ["symbol", "market", "enabled"]
          }
        }
      }
    },
    "telegram": { "type": "object" },
    "weixin": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "alert_enabled": { "type": "boolean" },
        "credential_path": { "type": "string" },
        "state_path": { "type": "string" },
        "command_polling_enabled": { "type": "boolean" },
        "send_startup_message": { "type": "boolean" }
      }
    },
    "ntfy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "base_url": { "type": "string" },
        "topic": { "type": "string" },
        "token": { "type": "string" },
        "alert_priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "broadcast_priority": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "desktop_notify": { "type": "object" },
    "commands": { "type": "object" },
    "logging": { "type": "object" }
  }
}
