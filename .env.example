# Proxy, useful in mainland China network environments.
SOCKS_PROXY=socks5h://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:7890

# Server port.
PORT=3000

# Optional fallback AI key for Google/Gemini mode. The preferred setup is now in
# Settings -> 新闻与 AI 分析: AI 中转站地址 + AI API Key + AI 模型.
# If no key is configured anywhere, the server automatically falls back to
# rule-based analysis.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Binance REST and WebSocket should point to the same environment, otherwise MA60
# deviation may be distorted.
# Mainnet:
# BINANCE_FAPI_BASE=https://fapi.binance.com
# BINANCE_WS_BASE=wss://fstream.binance.com/stream

# Testnet, useful when mainnet egress is blocked.
BINANCE_FAPI_BASE=https://testnet.binancefuture.com
BINANCE_WS_BASE=wss://stream.binancefuture.com/stream
